{
  "name": "claude-code-alerts",
  "displayName": "Claude Code Alerts: notifications for Claude Code terminals",
  "description": "Know which Claude Code session is done or needs you, and jump to the exact VS Code terminal tab. Companion of the Claude Code Alerts Mac app.",
  "version": "0.5.3",
  "publisher": "lucal1fe",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/LucaL1fe/claude-code-alerts"
  },
  "homepage": "https://github.com/LucaL1fe/claude-code-alerts",
  "bugs": {
    "url": "https://github.com/LucaL1fe/claude-code-alerts/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "notifications",
    "alerts",
    "terminal",
    "ai agent",
    "macos",
    "menu bar",
    "anthropic"
  ],
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "claudeCodeAlerts.sessions",
          "name": "Claude Sessions"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeCodeAlerts.goto",
        "title": "Go to Session",
        "category": "Claude Code Alerts"
      },
      {
        "command": "claudeCodeAlerts.settings",
        "title": "Claude Code Alerts: Open settings"
      },
      {
        "command": "claudeCodeAlerts.newSession",
        "title": "New Session",
        "category": "Claude Code Alerts",
        "icon": "$(add)"
      },
      {
        "command": "claudeCodeAlerts.newFolder",
        "title": "New Folder...",
        "category": "Claude Code Alerts",
        "icon": "$(new-folder)"
      },
      {
        "command": "claudeCodeAlerts.newSessionTopLevel",
        "title": "New Session",
        "category": "Claude Code Alerts",
        "icon": "$(add)"
      },
      {
        "command": "claudeCodeAlerts.newFolderTopLevel",
        "title": "New Folder...",
        "category": "Claude Code Alerts",
        "icon": "$(new-folder)"
      },
      {
        "command": "claudeCodeAlerts.rename",
        "title": "Rename...",
        "category": "Claude Code Alerts",
        "icon": "$(edit)"
      },
      {
        "command": "claudeCodeAlerts.deleteFolder",
        "title": "Delete Folder",
        "category": "Claude Code Alerts",
        "icon": "$(trash)"
      },
      {
        "command": "claudeCodeAlerts.removeSession",
        "title": "Remove from List",
        "category": "Claude Code Alerts",
        "icon": "$(trash)"
      },
      {
        "command": "claudeCodeAlerts.moveTo",
        "title": "Move to Folder...",
        "category": "Claude Code Alerts"
      },
      {
        "command": "claudeCodeAlerts.moveToTop",
        "title": "Move to Top Level",
        "category": "Claude Code Alerts"
      },
      {
        "command": "claudeCodeAlerts.moveUp",
        "title": "Move Up",
        "category": "Claude Code Alerts",
        "icon": "$(arrow-up)"
      },
      {
        "command": "claudeCodeAlerts.moveDown",
        "title": "Move Down",
        "category": "Claude Code Alerts",
        "icon": "$(arrow-down)"
      },
      {
        "command": "claudeCodeAlerts.setStateInput",
        "title": "Needs You",
        "category": "Claude Code Alerts"
      },
      {
        "command": "claudeCodeAlerts.setStateReview",
        "title": "Plan Ready",
        "category": "Claude Code Alerts"
      },
      {
        "command": "claudeCodeAlerts.setStateDone",
        "title": "Done",
        "category": "Claude Code Alerts"
      },
      {
        "command": "claudeCodeAlerts.setStateIdle",
        "title": "Idle",
        "category": "Claude Code Alerts"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "claudeCodeAlerts.newSessionTopLevel",
          "when": "view == claudeCodeAlerts.sessions",
          "group": "navigation@1"
        },
        {
          "command": "claudeCodeAlerts.newFolderTopLevel",
          "when": "view == claudeCodeAlerts.sessions",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "claudeCodeAlerts.moveUp",
          "when": "view == claudeCodeAlerts.sessions && viewItem =~ /canUp/",
          "group": "inline@1"
        },
        {
          "command": "claudeCodeAlerts.moveDown",
          "when": "view == claudeCodeAlerts.sessions && viewItem =~ /canDown/",
          "group": "inline@2"
        },
        {
          "command": "claudeCodeAlerts.newSession",
          "when": "view == claudeCodeAlerts.sessions && viewItem =~ /^folder/",
          "group": "inline@3"
        },
        {
          "command": "claudeCodeAlerts.rename",
          "when": "view == claudeCodeAlerts.sessions",
          "group": "inline@4"
        },
        {
          "command": "claudeCodeAlerts.deleteFolder",
          "when": "view == claudeCodeAlerts.sessions && viewItem =~ /^folder/",
          "group": "inline@5"
        },
        {
          "command": "claudeCodeAlerts.removeSession",
          "when": "view == claudeCodeAlerts.sessions && viewItem =~ /^session/",
          "group": "inline@5"
        },
        {
          "command": "claudeCodeAlerts.newSession",
          "when": "view == claudeCodeAlerts.sessions",
          "group": "1_new@1"
        },
        {
          "command": "claudeCodeAlerts.newFolder",
          "when": "view == claudeCodeAlerts.sessions",
          "group": "1_new@2"
        },
        {
          "command": "claudeCodeAlerts.goto",
          "when": "view == claudeCodeAlerts.sessions && viewItem =~ /^session/",
          "group": "2_go"
        },
        {
          "submenu": "claudeCodeAlerts.setState",
          "when": "view == claudeCodeAlerts.sessions && viewItem =~ /^session/",
          "group": "2_go@2"
        },
        {
          "command": "claudeCodeAlerts.moveTo",
          "when": "view == claudeCodeAlerts.sessions",
          "group": "3_move@1"
        },
        {
          "command": "claudeCodeAlerts.moveToTop",
          "when": "view == claudeCodeAlerts.sessions && viewItem =~ /nested/",
          "group": "3_move@2"
        },
        {
          "command": "claudeCodeAlerts.moveUp",
          "when": "view == claudeCodeAlerts.sessions && viewItem =~ /canUp/",
          "group": "3_move@3"
        },
        {
          "command": "claudeCodeAlerts.moveDown",
          "when": "view == claudeCodeAlerts.sessions && viewItem =~ /canDown/",
          "group": "3_move@4"
        },
        {
          "command": "claudeCodeAlerts.rename",
          "when": "view == claudeCodeAlerts.sessions",
          "group": "4_edit@1"
        },
        {
          "command": "claudeCodeAlerts.deleteFolder",
          "when": "view == claudeCodeAlerts.sessions && viewItem =~ /^folder/",
          "group": "4_edit@2"
        },
        {
          "command": "claudeCodeAlerts.removeSession",
          "when": "view == claudeCodeAlerts.sessions && viewItem =~ /^session/",
          "group": "4_edit@2"
        }
      ],
      "commandPalette": [
        {
          "command": "claudeCodeAlerts.goto",
          "when": "false"
        },
        {
          "command": "claudeCodeAlerts.rename",
          "when": "false"
        },
        {
          "command": "claudeCodeAlerts.deleteFolder",
          "when": "false"
        },
        {
          "command": "claudeCodeAlerts.removeSession",
          "when": "false"
        },
        {
          "command": "claudeCodeAlerts.moveTo",
          "when": "false"
        },
        {
          "command": "claudeCodeAlerts.moveToTop",
          "when": "false"
        },
        {
          "command": "claudeCodeAlerts.moveUp",
          "when": "false"
        },
        {
          "command": "claudeCodeAlerts.moveDown",
          "when": "false"
        },
        {
          "command": "claudeCodeAlerts.newSession",
          "when": "false"
        },
        {
          "command": "claudeCodeAlerts.newFolder",
          "when": "false"
        },
        {
          "command": "claudeCodeAlerts.setStateInput",
          "when": "false"
        },
        {
          "command": "claudeCodeAlerts.setStateReview",
          "when": "false"
        },
        {
          "command": "claudeCodeAlerts.setStateDone",
          "when": "false"
        },
        {
          "command": "claudeCodeAlerts.setStateIdle",
          "when": "false"
        }
      ],
      "claudeCodeAlerts.setState": [
        {
          "command": "claudeCodeAlerts.setStateInput",
          "group": "1_state@1"
        },
        {
          "command": "claudeCodeAlerts.setStateReview",
          "group": "1_state@2"
        },
        {
          "command": "claudeCodeAlerts.setStateDone",
          "group": "1_state@3"
        },
        {
          "command": "claudeCodeAlerts.setStateIdle",
          "group": "2_clear@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "claudeCodeAlerts.rename",
        "key": "f2",
        "when": "focusedView == claudeCodeAlerts.sessions"
      },
      {
        "command": "claudeCodeAlerts.deleteFolder",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == claudeCodeAlerts.sessions"
      },
      {
        "command": "claudeCodeAlerts.moveUp",
        "key": "alt+up",
        "when": "focusedView == claudeCodeAlerts.sessions"
      },
      {
        "command": "claudeCodeAlerts.moveDown",
        "key": "alt+down",
        "when": "focusedView == claudeCodeAlerts.sessions"
      }
    ],
    "colors": [
      {
        "id": "claudeCodeAlerts.needsYou",
        "description": "Claude Sessions view: a session that needs you, and its folders.",
        "defaults": {
          "dark": "#FF9F0A",
          "light": "#B35F00",
          "highContrast": "#FF9F0A",
          "highContrastLight": "#B35F00"
        }
      },
      {
        "id": "claudeCodeAlerts.plan",
        "description": "Claude Sessions view: a plan ready to review.",
        "defaults": {
          "dark": "#BF5AF2",
          "light": "#8E3FD0",
          "highContrast": "#BF5AF2",
          "highContrastLight": "#8E3FD0"
        }
      },
      {
        "id": "claudeCodeAlerts.done",
        "description": "Claude Sessions view: a session that finished.",
        "defaults": {
          "dark": "#34C759",
          "light": "#1E8E3E",
          "highContrast": "#34C759",
          "highContrastLight": "#1E8E3E"
        }
      },
      {
        "id": "claudeCodeAlerts.error",
        "description": "Claude Sessions view: an error, or Claude using your Mac.",
        "defaults": {
          "dark": "#FF453A",
          "light": "#D93025",
          "highContrast": "#FF453A",
          "highContrastLight": "#D93025"
        }
      },
      {
        "id": "claudeCodeAlerts.working",
        "description": "Claude Sessions view: a session at work.",
        "defaults": {
          "dark": "#4C8DFF",
          "light": "#1A66E0",
          "highContrast": "#4C8DFF",
          "highContrastLight": "#1A66E0"
        }
      }
    ],
    "configuration": {
      "title": "Claude Code Alerts",
      "properties": {
        "claudeCodeAlerts.devTerminals": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Development only: allow the app's demo scripts to open terminals in this workspace."
        },
        "claudeCodeAlerts.newSessionCommand": {
          "type": "string",
          "default": "claude",
          "scope": "machine",
          "description": "Command that New Session runs in its new terminal (for example \"claude --model opus\")."
        },
        "claudeCodeAlerts.newSessionLocation": {
          "type": "string",
          "enum": [
            "editor",
            "panel"
          ],
          "default": "editor",
          "scope": "machine",
          "enumDescriptions": [
            "A terminal tab in the editor area.",
            "A terminal in the panel."
          ],
          "description": "Where New Session opens its terminal."
        },
        "claudeCodeAlerts.restoreSessions": {
          "type": "boolean",
          "default": true,
          "description": "After VS Code or your Mac restarts, resume the Claude sessions that were open in this window, each in its old terminal tab (claude --resume)."
        },
        "claudeCodeAlerts.foldersPosition": {
          "type": "string",
          "enum": [
            "bottom",
            "top"
          ],
          "default": "bottom",
          "enumDescriptions": [
            "Sessions first, your folders below them.",
            "Your folders first, sessions below them."
          ],
          "description": "Where your folders sit in the Claude Sessions view, on every level."
        }
      }
    },
    "submenus": [
      {
        "id": "claudeCodeAlerts.setState",
        "label": "Set State"
      }
    ]
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Works in Restricted Mode; demo terminals are off there.",
      "restrictedConfigurations": [
        "claudeCodeAlerts.devTerminals"
      ]
    },
    "virtualWorkspaces": true
  }
}
